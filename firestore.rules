rules_version = '2';

// El Sótano Bar — reglas de Firestore
//
// Modelo:
//   carta/{itemId}    Lectura pública. Escritura (precios, stock, disponible) solo barra.
//   pedidos/{id}      Cliente crea a su nombre y en estado "nuevo". Lee SOLO los suyos.
//                     Cambios de estado: solo barra.
//   barra/{doc=**}    Privado de la barra (caja, turnos, config). Cliente no lee ni escribe.
//
// Identidad de barra: claim personalizado rol=="barra" (preferido, cero lecturas),
// con fallback a lista de mails. Los anónimos no tienen email en el token, así que
// nunca entran por el fallback.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function logueado() {
      return request.auth != null;
    }

    function mailDeBarra() {
      // Agregar mails acá y redesplegar: npm run deploy:rules
      return [
        'emmanuelclubdelmate@gmail.com'
      ];
    }

    // El dueño del local. No depende de ningún documento: no puede dejarse
    // afuera solo. Ojo: esDueno(uid), más abajo, es otra cosa — el dueño de
    // un pedido.
    // El claim 'rol' del token vale 'barra' por historia: marca al dueño y lo
    // asigna el servidor con la clave privada. No tiene nada que ver con el
    // campo rol de accesosBarra, que distingue admin de barman.
    function esElDueno() {
      return logueado() && (
        request.auth.token.get('rol', '') == 'barra'
        || request.auth.token.get('email', '') in mailDeBarra()
      );
    }

    // Personal del turno: una cuenta usuario/contraseña que se da de alta para
    // un evento y se apaga cuando termina. El permiso vive en
    // accesosBarra/{uid}, así que apagarlo corta el acceso en el momento, sin
    // tocar reglas ni redesplegar.
    function miAcceso() {
      return get(/databases/$(database)/documents/accesosBarra/$(request.auth.uid)).data;
    }

    function tengoTurno() {
      return logueado()
        && exists(/databases/$(database)/documents/accesosBarra/$(request.auth.uid))
        && miAcceso().activo == true;
    }

    // Tres niveles:
    //   dueño   — todo, incluido borrar. Es el único que borra.
    //   admin   — administra todo salvo borrar. Cuenta permanente.
    //   barman  — mueve pedidos y marca agotado. Ve precios, caja y eventos,
    //             pero solo las noches en que está asignado al evento.
    //   puerta  — registra quién entra. No ve la caja ni toca la carta.
    function miRol() {
      return tengoTurno() ? miAcceso().get('rol', 'barman') : '';
    }

    // Un nivel más arriba que admin. La diferencia es una sola: elige qué ve
    // cada uno. El dueño entra acá sin documento —su permiso sale del mail— y
    // por eso nadie se lo puede sacar, ni un sadmin.
    function esSuperAdmin() {
      return esElDueno() || miRol() == 'sadmin';
    }

    // El dueño primero: resuelve con el token y no cuesta ninguna lectura.
    function esAdmin() {
      return esSuperAdmin() || miRol() == 'admin';
    }

    // Qué puede hacer cada uno, pantalla por pantalla. Lo elige un sadmin
    // desde Usuarios y vive en su propio acceso.
    //
    // Esconder una pestaña no es un permiso: si el dato se puede escribir
    // igual, la pantalla es decorado. Por eso cada interruptor frena también
    // acá, en lo que esa pantalla hace.
    //
    // Sin permisos cargados vale true: manda el rol, como siempre. Que esta
    // pantalla exista no le saca nada a nadie.
    //
    // Al sadmin no lo limita: es el que reparte. Si pudiera quedar recortado,
    // podría dar lo que no tiene, o dejarse afuera sin manera de volver.
    function puedo(que) {
      return esSuperAdmin()
        || (tengoTurno() && miAcceso().get('permisos', {}).get(que, true) == true);
    }

    // El celular que vive en la barra tiene su propia cuenta, siempre prendida:
    // el bar vende todos los días, no solo las noches de evento. No depende del
    // turno. Si hay que cortarle el acceso, se da de baja como a cualquiera.
    function esAparatoDeBarra() {
      return miRol() == 'barra';
    }

    // Quién trabaja esta noche. barra/turno lo escriben los administradores al
    // abrir el evento; al cerrarlo queda vacío y ningún barman entra.
    function barmanDeTurno() {
      return miRol() == 'barman'
        && exists(/databases/$(database)/documents/barra/turno)
        && request.auth.uid in get(/databases/$(database)/documents/barra/turno)
             .data.get('barmanes', []);
    }

    function esBarra() {
      return esAdmin() || barmanDeTurno() || esAparatoDeBarra();
    }

    // Qué roles existen, y cuáles puede repartir cada uno. 'sadmin' solo lo da
    // otro sadmin: si un admin pudiera, se ascendería solo.
    function rolQuePuedoDar(r) {
      return r in ['admin', 'barman', 'puerta', 'barra']
        || (r == 'sadmin' && esSuperAdmin());
    }

    function tocaPermisos() {
      return 'permisos' in request.resource.data.diff(resource.data).affectedKeys();
    }

    // Las pantallas que existen. Un interruptor con un nombre inventado no
    // haría nada, pero ensuciaría el documento y confundiría al que lo lea.
    function accesoValido(d) {
      return d.keys().hasOnly(['usuario', 'rol', 'activo', 'creadoEn', 'permisos'])
        && d.usuario is string && d.usuario.size() >= 3 && d.usuario.size() <= 30
        && d.activo is bool
        && (!('permisos' in d.keys()) || (d.permisos is map
            && d.permisos.keys().hasOnly(['pedidos', 'carta', 'noche', 'caja',
                                          'deposito', 'calendario', 'puerta'])));
    }

    // La puerta solo trabaja la noche en que está asignada, igual que el barman.
    function esPuerta() {
      return miRol() == 'puerta'
        && exists(/databases/$(database)/documents/barra/turno)
        && request.auth.uid in get(/databases/$(database)/documents/barra/turno)
             .data.get('barmanes', []);
    }

    // Lo que la barra puede tocar de un producto: si se acabó y cuánto queda.
    // Los precios, el nombre y la categoría son del gerente para arriba.
    function soloStock() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock', 'disponible']);
    }

    function esDueno(uid) {
      return logueado() && request.auth.uid == uid;
    }

    // ¿El local está tomando pedidos? Lo marca publico/estado, que la barra
    // prende al abrir un evento y apaga al cerrarlo. Así el QR pegado en la
    // mesa sigue sirviendo siempre, pero fuera del evento no entra nada.
    //
    // Si el documento no existe, se toman pedidos: un borrado accidental deja
    // el bar funcionando, no mudo. Apagarlo es un acto explícito de la barra.
    function tomandoPedidos() {
      return !exists(/databases/$(database)/documents/publico/estado)
        || get(/databases/$(database)/documents/publico/estado).data.get('tomandoPedidos', true) == true;
    }

    // Estados válidos del ciclo de vida de un pedido
    function estadosValidos() {
      return ['nuevo', 'en_preparacion', 'listo', 'entregado', 'cancelado'];
    }

    // Forma mínima que debe tener un pedido creado por un cliente.
    // Nota: los precios los manda el cliente. Las reglas no pueden sumar arrays,
    // así que la integridad del total se verifica en el panel de barra (ver LEEME).
    function pedidoValido(d) {
      return d.keys().hasAll(['clienteId', 'estado', 'items', 'total', 'creadoEn'])
        && d.keys().hasOnly(['clienteId', 'estado', 'items', 'total', 'mesa', 'nota',
                             'nombreCliente', 'invitadoId', 'creadoEn',
                             'cajaId', 'origen', 'pago', 'vendidoPor', 'cobradoEn'])
        && d.clienteId is string
        && d.estado is string
        && d.items is list
        && d.items.size() > 0
        && d.items.size() <= 40
        && d.total is number
        && d.total >= 0
        && d.total <= 5000000
        && d.creadoEn == request.time
        && (!('mesa' in d.keys()) || (d.mesa is string && d.mesa.size() <= 20))
        && (!('nota' in d.keys()) || (d.nota is string && d.nota.size() <= 300))
        && (!('nombreCliente' in d.keys()) || (d.nombreCliente is string && d.nombreCliente.size() <= 60))
        // Ata el pedido al invitado para poder ver el consumo de cada uno.
        && (!('invitadoId' in d.keys()) || (d.invitadoId is string && d.invitadoId.size() <= 40))
        // A qué caja entra: el id del evento, o "dia-AAAA-MM-DD" cuando no hay
        // evento abierto. Sin esto la venta diaria no suma en ningún lado.
        && (!('cajaId' in d.keys()) || (d.cajaId is string && d.cajaId.size() <= 60))
        && (!('origen' in d.keys()) || d.origen in ['cliente', 'barra'])
        && (!('pago' in d.keys()) || d.pago in ['efectivo', 'virtual'])
        && (!('vendidoPor' in d.keys()) || (d.vendidoPor is string && d.vendidoPor.size() <= 40))
        && (!('cobradoEn' in d.keys()) || d.cobradoEn == request.time);
    }

    // Lo que la barra puede tocar de un pedido ya hecho: moverlo de columna y,
    // al entregarlo, decir cómo se pagó y quién lo despachó. Nunca los items ni
    // el total: eso quedó fijado cuando se hizo.
    function soloCobro() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['estado', 'pago', 'vendidoPor', 'cobradoEn']);
    }

    // Una venta cargada desde la barra: sale cobrada y entregada, con quién la
    // hizo. El cliente del mostrador no usa la app, así que la carga la barra.
    function ventaDeBarra(d) {
      return d.get('origen', '') == 'barra'
        && d.estado == 'entregado'
        && d.get('pago', '') in ['efectivo', 'virtual']
        && d.get('vendidoPor', '') is string;
    }

    // El depósito: lo que se compra y se guarda. El stock se lleva en MEDIDAS,
    // no en unidades: una botella de 750 con medidas de 70 son 10 medidas, y
    // un trago descuenta una. Para lo cerrado (lata, paquete) medidas es 1 y
    // una medida es una unidad.
    function insumoValido(d) {
      return d.keys().hasOnly(['nombre', 'unidad', 'medidas', 'stock', 'costo',
                               'proveedorId', 'minimo', 'creadoEn'])
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 60
        && d.get('unidad', '') is string
        && d.medidas is int && d.medidas >= 1 && d.medidas <= 1000
        && d.stock is number && d.stock >= 0
        && d.get('costo', 0) is number && d.get('costo', 0) >= 0
        && d.get('minimo', 0) is number && d.get('minimo', 0) >= 0;
    }

    // Lo único que la barra toca de un insumo es cuánto queda: el descuento al
    // entregar. Precios, medidas y nombres son del administrador.
    function soloStockInsumo() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
    }

    // Un ingreso de mercadería. 'inicial' es la carga de arranque: suma stock y
    // no es plata que salió. 'contado' se paga en el acto y además queda como
    // gasto; 'cuenta' no toca la caja hasta que se le pague al proveedor.
    function compraValida(d) {
      return d.keys().hasOnly(['proveedorId', 'proveedor', 'fecha', 'items', 'total',
                               'condicion', 'pago', 'cargadoPor', 'creadoEn'])
        && d.items is list && d.items.size() > 0 && d.items.size() <= 60
        && d.total is number && d.total >= 0 && d.total <= 50000000
        && d.condicion in ['contado', 'cuenta', 'inicial']
        && d.fecha is timestamp
        && (!('pago' in d.keys()) || d.pago in ['efectivo', 'virtual'])
        && d.get('proveedor', '') is string;
    }

    function conteoValido(d) {
      return d.keys().hasOnly(['cajaId', 'nombre', 'apertura', 'cierre',
                              'aperturaEn', 'cierreEn', 'aperturaPor', 'cierrePor'])
        && d.get('cajaId', '') is string
        && (!('apertura' in d.keys()) || d.apertura is map)
        && (!('cierre' in d.keys()) || d.cierre is map);
    }

    function egresoValido(d) {
      return d.keys().hasAll(['concepto', 'categoria', 'monto', 'pago', 'fecha'])
        && d.keys().hasOnly(['concepto', 'categoria', 'monto', 'pago', 'fecha',
                             'cajaId', 'cargadoPor', 'creadoEn',
                             // Un gasto con proveedor es un pago a cuenta: es lo
                             // que baja la deuda en la cuenta corriente.
                             'proveedorId', 'compraId'])
        && d.concepto is string && d.concepto.size() >= 2 && d.concepto.size() <= 80
        && d.categoria in ['proveedor', 'sueldo', 'insumo', 'retiro', 'otro']
        && d.monto is number && d.monto > 0 && d.monto <= 5000000
        && d.pago in ['efectivo', 'virtual']
        && d.fecha is timestamp;
    }

    // ---------- carta ----------

    match /carta/{itemId} {
      // La carta se ve sin loguearse: el QR de la mesa abre y muestra.
      allow read: if true;
      // Precios, nombres y altas: gerente para arriba.
      allow create: if esAdmin() && puedo('carta');
      // La barra solo marca agotado y ajusta el stock de lo que ya existe.
      allow update: if (esAdmin() && puedo('carta')) || (esBarra() && soloStock());
      // Borrar es del dueño y de nadie más.
      allow delete: if esElDueno();
    }

    // ---------- pedidos ----------

    match /pedidos/{pedidoId} {
      // El cliente ve solo los propios; la barra ve todos.
      // En list, el cliente DEBE filtrar where('clienteId','==',uid) o la query falla entera.
      allow get, list: if esBarra() || (logueado() && esDueno(resource.data.clienteId));

      // Crear: a su propio nombre, arrancando en "nuevo", y solo mientras el
      // local esté tomando pedidos. La barra puede cargar uno a mano siempre.
      allow create: if logueado()
        && esDueno(request.resource.data.clienteId)
        && pedidoValido(request.resource.data)
        && (
          // El cliente, desde su celular: arranca en "nuevo" y solo si el local
          // está tomando pedidos.
          (request.resource.data.estado == 'nuevo'
            && (esBarra() || tomandoPedidos()))
          // O la barra cargando una venta de mostrador, que nace cobrada.
          || (esBarra() && ventaDeBarra(request.resource.data))
        );

      // Mover el pedido por el tablero. La barra toca el estado y nada más:
      // el total y los items de un pedido ya hecho no se reescriben.
      // El cliente y la hora no se tocan nunca, ni el dueño: reasignarle un
      // pedido a otra persona no es una operación legítima de nadie.
      allow update: if esBarra() && puedo('pedidos')
        && request.resource.data.estado in estadosValidos()
        && request.resource.data.clienteId == resource.data.clienteId
        && request.resource.data.creadoEn == resource.data.creadoEn
        && (esElDueno() || soloCobro());

      // Borrar es del dueño y de nadie más.
      allow delete: if esElDueno();
    }

    // ---------- barra (privado) ----------

    // Leer es de toda la barra. Escribir se parte en dos, porque son dos
    // pantallas distintas: agendar noches es el Calendario, y decir quién
    // trabaja esta noche es la Noche.
    //
    // Ojo con el orden: Firestore concede si CUALQUIER match permite, así que
    // una regla más específica no alcanza para restringir — hay que sacarle el
    // permiso de escritura al comodín, que es lo que se hace acá.
    match /barra/{documento=**} {
      allow read: if esBarra();
      allow delete: if esElDueno();
    }

    match /barra/eventos/items/{id} {
      allow create, update: if esAdmin() && puedo('calendario');
    }

    match /barra/turno {
      allow create, update: if esAdmin() && puedo('noche');
    }

    // ---------- estado del local, público ----------
    // Lo lee cualquiera sin loguearse: el QR de la mesa necesita saber si se
    // está tomando pedidos antes incluso de que el cliente entre.
    match /publico/{documento} {
      allow read: if true;
      // Cortar y reabrir los pedidos es del administrador.
      allow create, update: if esAdmin();
      allow delete: if esElDueno();
    }

    // El contador de registrados lo sube quien se registra, de a uno y solo
    // mientras quede lugar. Es lo único que un desconocido puede escribir.
    // ---------- el registro de cada noche ----------
    // Uno por evento. El link de una noche no lleva a otra: por eso el id del
    // evento es el nombre del documento y va en la URL.
    match /registros/{ev} {
      // Lo lee cualquiera: es lo que abre el link de esa noche.
      allow get: if true;
      allow list: if esBarra() || esPuerta();
      allow create, delete: if esAdmin() && puedo('calendario');
      // El que se anota suma uno, y nada más, y solo si queda lugar.
      allow update: if (esAdmin() && puedo('calendario'))
        || (hayLugarEn(ev)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrados'])
            && request.resource.data.registrados == resource.data.registrados + 1);
    }

    // ---------- invitados de la noche ----------
    //
    // El id es un token largo al azar y hace de llave: quien lo tiene ve su
    // pase, y nadie más. Listar la tanda entera es de la casa.
    //
    // El cupo es best effort: las reglas no saben contar documentos, así que
    // se apoyan en el contador de publico/registro. Sirve para cerrar el
    // registro cuando se llena, no para blindarlo. El control real es la
    // puerta, que ve el total en vivo.
    // Cada noche con cupo tiene su registro: registros/<id del evento>. Así dos
    // noches abiertas a la vez tienen cada una su link, su QR y su cuenta.
    // publico/registro quedó como puntero para el link viejo, sin números.
    function registro(ev) {
      return get(/databases/$(database)/documents/registros/$(ev)).data;
    }

    function hayLugarEn(ev) {
      return ev is string && ev != ''
        && exists(/databases/$(database)/documents/registros/$(ev))
        && registro(ev).get('abierto', false) == true
        && registro(ev).get('registrados', 0) < registro(ev).get('capacidad', 0);
    }

    function invitadoValido(d) {
      // 'pago' es cómo dijo que va a pagar la entrada: en la puerta o por
      // transferencia. Lo elige al anotarse y es un dato suyo, no plata
      // cobrada: que haya dicho "transferencia" no significa que transfirió.
      // Quien cobra sigue siendo la puerta.
      return d.keys().hasOnly(['eventoId', 'nombre', 'telefono', 'creadoEn', 'ingresadoEn', 'ingresadoPor',
                               'pago', 'pagadoEn', 'pagadoPor'])
        && d.keys().hasAll(['eventoId', 'nombre', 'telefono', 'creadoEn'])
        && d.get('pago', 'efectivo') in ['efectivo', 'virtual']
        // Nadie se marca su propio pago al anotarse: eso lo confirma la casa
        // después de ver la transferencia.
        && d.get('pagadoEn', null) == null
        && d.eventoId is string
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 60
        // Un solo formato: diez números, sin el 0 y sin el 15. Si cada uno lo
        // escribe a su manera, el candado del teléfono no sirve para nada.
        && d.telefono is string && d.telefono.matches('^[1-9][0-9]{9}$')
        && d.creadoEn == request.time
        && d.get('ingresadoEn', null) == null;
    }

    // El candado de "un teléfono, una anotación". La llave tiene que ser la
    // noche y el número: así el documento que choca es siempre el mismo.
    function candadoValido(clave, d) {
      return d.keys().hasOnly(['eventoId', 'tel', 'creadoEn'])
        && d.keys().hasAll(['eventoId', 'tel', 'creadoEn'])
        && d.tel is string && d.tel.matches('^[0-9]{6,10}$')
        && clave == d.eventoId + '__' + d.tel
        && d.creadoEn == request.time;
    }

    // La casa anota a alguien de último momento aunque esté lleno y aunque el
    // registro esté cerrado: es su decisión. Y puede darlo por entrado en el
    // mismo acto, que es lo que pasa cuando alguien aparece en la puerta.
    function invitadoDeLaCasa(d) {
      return d.keys().hasOnly(['eventoId', 'nombre', 'telefono', 'creadoEn', 'ingresadoEn', 'ingresadoPor'])
        && d.keys().hasAll(['eventoId', 'nombre', 'telefono', 'creadoEn'])
        && d.eventoId is string
        && d.nombre is string && d.nombre.size() >= 2 && d.nombre.size() <= 60
        // La casa usa el mismo molde, o lo deja vacío: en la puerta a veces no
        // hay teléfono y no se le va a negar la entrada por eso.
        && d.telefono is string
        && (d.telefono == '' || d.telefono.matches('^[1-9][0-9]{9}$'))
        && d.creadoEn == request.time;
    }

    match /invitados/{token} {
      // Con el token en la mano ves tu pase. Sin él, nada.
      allow get: if true;
      allow list: if esBarra() || esPuerta();

      // Se registra cualquiera mientras haya lugar y el registro esté abierto,
      // y siempre contra el evento que publico/registro declara abierto.
      allow create: if (token.size() >= 16
          && invitadoValido(request.resource.data)
          && hayLugarEn(request.resource.data.eventoId))
        || (esAdmin() && token.size() >= 16 && invitadoDeLaCasa(request.resource.data));

      // Marcar el ingreso: puerta o casa. Nadie se marca su propia entrada.
      //
      // Un pase, una entrada: solo se puede marcar lo que está sin marcar. Si
      // alguien pasa su QR por WhatsApp, el segundo que lo muestre no entra, y
      // no depende de que la pantalla se acuerde. Deshacer sí se puede: es para
      // el error de la puerta, y vuelve a dejarlo entrar una vez.
      allow update: if (esPuerta() || esBarra()) && puedo('puerta')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ingresadoEn', 'ingresadoPor'])
        && (resource.data.get('ingresadoEn', null) == null
            || request.resource.data.get('ingresadoEn', null) == null);

      // Confirmar que la transferencia llegó. Es plata, así que lo hace la
      // barra o la casa, nunca la puerta ni el invitado: el que mira el banco
      // no es el que está en la entrada. Se puede deshacer, por si se
      // confundió de persona.
      allow update: if esBarra()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['pagadoEn', 'pagadoPor']);

      // Sacar a alguien de la lista es de la casa: se anotó dos veces, se
      // equivocó de noche. No es borrar la base, es arreglar la lista.
      allow delete: if esAdmin();
    }

    // ---------- un teléfono, una anotación por noche ----------
    // El candado de la lista. Se crea en el mismo lote que el invitado y el
    // contador: como se puede crear pero nunca pisar, el segundo intento con
    // el mismo número hace fallar el lote entero y no se anota nada.
    //
    // De afuera no se lee a propósito: si se pudiera, cualquiera probaría
    // teléfonos para averiguar quién está en la lista de esta noche.
    match /anotados/{clave} {
      allow get, list: if esBarra() || esPuerta();
      allow create: if (hayLugarEn(request.resource.data.get('eventoId', ''))
            && candadoValido(clave, request.resource.data))
        || (esAdmin()
            && request.resource.data.keys().hasOnly(['eventoId', 'tel', 'creadoEn'])
            && request.resource.data.creadoEn == request.time);
      // Pisarlo seria desarmar el candado.
      allow update: if false;
      // La casa lo libera si anoto mal un numero.
      allow delete: if esAdmin();
    }

    // ---------- el depósito ----------
    // Lo ve toda la barra: necesita saber qué hay. Lo da de alta y le pone
    // precio el administrador; la barra solo descuenta al entregar.
    match /insumos/{id} {
      allow read: if esBarra();
      allow create: if esAdmin() && puedo('deposito') && insumoValido(request.resource.data);
      allow update: if (esAdmin() && puedo('deposito') && insumoValido(request.resource.data))
        || (esBarra() && soloStockInsumo());
      allow delete: if esAdmin();
    }

    // ---------- ingresos de mercadería ----------
    // La compra suma stock. Si fue al contado, ademas queda un gasto en la
    // caja; si fue a cuenta, queda como deuda con el proveedor hasta que se
    // le pague. La plata es de la casa: esto no lo carga la barra.
    match /compras/{id} {
      allow read: if esAdmin() && puedo('deposito');
      allow create, update: if esAdmin() && puedo('deposito')
        && compraValida(request.resource.data);
      allow delete: if esAdmin();
    }

    match /proveedores/{id} {
      // La barra lo lee para saber de quién es cada cosa; la cuenta no.
      allow read: if esBarra();
      allow create, update: if esAdmin()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 60;
      allow delete: if esAdmin();
    }

    // ---------- bajas del depósito ----------
    // Borrar un insumo no deja rastro, y a veces hace falta saber por qué
    // desapareció algo que estaba. Cada baja queda acá con su motivo, quién la
    // hizo y cuánto había. Es historia: se escribe una vez y no se toca más.
    match /bajas/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasAll(['nombre', 'motivo', 'quien', 'cuando'])
        && request.resource.data.keys().hasOnly(['nombre', 'motivo', 'quien', 'cuando',
                                                 'insumoId', 'stock', 'unidad'])
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() >= 3
        && request.resource.data.motivo.size() <= 200
        && request.resource.data.cuando == request.time;
      // No se edita ni se borra: si se pudiera, no serviría de nada.
      allow update, delete: if false;
    }

    // ---------- el conteo de la noche ----------
    // Control, no inventario: lo que se cuenta a mano al abrir y al cerrar.
    // NO mueve el stock de la carta — ese baja solo al entregar. Sirve para
    // comparar lo que habia, lo que se vendio y lo que quedo, y ver si falta.
    //
    // Lo carga quien atiende: es la persona que tiene las botellas delante.
    match /conteos/{caja} {
      allow read: if esBarra();
      allow create, update: if esBarra() && conteoValido(request.resource.data);
      allow delete: if esAdmin();
    }

    // ---------- la plata que sale ----------
    // Un egreso baja la caja, así que lo cargan los dueños y nadie más: si lo
    // pudiera cargar el celular de la barra, el efectivo que la app dice que
    // hay en el cajón dejaría de servir para controlar nada.
    match /egresos/{id} {
      allow read: if esAdmin() && puedo('caja');
      allow create: if esAdmin() && puedo('caja') && egresoValido(request.resource.data);
      allow update: if esAdmin() && puedo('caja') && egresoValido(request.resource.data);
      allow delete: if esAdmin() && puedo('caja');
    }

    // ---------- el padrón: quién puede entrar al panel ----------
    // Va fuera de barra/ a propósito: si estuviera adentro, la regla de arriba
    // dejaría que el personal se editara su propio permiso.
    match /accesosBarra/{uid} {
      // Cada uno puede ver el suyo: el panel avisa cuando lo apagaron.
      allow get: if esAdmin() || esDueno(uid);
      // El celular de la barra también la lee: necesita los nombres para que
      // quien atiende se elija de una lista y no escribiéndolo a mano. Son
      // nombres y roles, no hay nada secreto acá.
      allow list: if esAdmin() || esAparatoDeBarra();
      // Un administrador da de alta y apaga a cualquiera. Lo que NO puede es
      // tocar a un sadmin, hacer sadmin a alguien, ni mover permisos: para
      // eso hay que ser sadmin.
      //
      // Y nadie se toca su propio acceso, ni un sadmin. Si pudiera, un admin
      // se ascendería solo y la jerarquía no existiría. Al dueño no lo afecta:
      // no tiene documento, su permiso sale del mail.
      allow create: if esAdmin()
        && uid != request.auth.uid
        && accesoValido(request.resource.data)
        && rolQuePuedoDar(request.resource.data.get('rol', 'barman'))
        && (!('permisos' in request.resource.data.keys()) || esSuperAdmin());

      allow update: if esAdmin()
        && uid != request.auth.uid
        && accesoValido(request.resource.data)
        // Ni al que ya es sadmin, ni para convertir a alguien en sadmin.
        && rolQuePuedoDar(request.resource.data.get('rol', 'barman'))
        && rolQuePuedoDar(resource.data.get('rol', 'barman'))
        // Los interruptores los mueve solo un sadmin.
        && (!tocaPermisos() || esSuperAdmin());

      allow delete: if esElDueno();
    }

    // ---------- todo lo demás ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
